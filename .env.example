# ============================================================================
# FuseHealth — Environment Variables Template
# Copy to .env and fill in values.  NEVER commit .env.
#
# Availability legend (status of the real .env as of the 2026-06-10 audit;
# re-run `python scripts/audit_env.py` to refresh):
#   [READY]   credentials present and live-auth PASSED
#   [PRESENT] credentials present, not live-tested here
#   [EMPTY]   no credentials yet — connector is UNAVAILABLE until filled
# ============================================================================

# ----------------------------------------------------------------------------
# Django
# ----------------------------------------------------------------------------
# Dev uses a built-in throwaway key; PRODUCTION REQUIRES this to be set or it
# refuses to start. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Comma-separated hostnames for production, e.g. dashboard.fusehealth.com,1.2.3.4
DJANGO_ALLOWED_HOSTS=
# Comma-separated, scheme included, e.g. https://dashboard.fusehealth.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional path overrides (sensible defaults live in config/settings/base.py)
# DJANGO_INTERNAL_DB=
# ANALYTICS_DB_PATH=

# ----------------------------------------------------------------------------
# PostgreSQL (optional)              [EMPTY]  leave blank to keep SQLite
# ----------------------------------------------------------------------------
# POSTGRES_DB is the master switch.
#   * Left EMPTY  -> nothing changes. Django uses django_internal.db and the
#                    analytics pipeline uses the SQLite file at ANALYTICS_DB_PATH,
#                    exactly as today. This is the rollback path.
#   * Filled in   -> Django uses django.db.backends.postgresql, AND the analytics
#                    pipeline is pointed at the SAME database via a generated
#                    ANALYTICS_DB_URL (postgresql+psycopg://...).
#
# ONE database holds both sets of tables. Django's tables (auth, sessions, admin,
# UserProfile, sync_log) are created by `manage.py migrate`; the analytics tables
# are created by SQLAlchemy's init_db(). The names don't collide.
#
# Requires the driver: pip install "psycopg[binary]>=3.2" (already in requirements.txt).
# The password is URL-encoded when the DSN is built, so special characters are safe.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Defaults if omitted: localhost / 5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Internal team passwords, read by `python manage.py seed_users`.
# If unset, seed_users sets a temporary 'changeme-<role>' password and warns you.
FUSEHEALTH_FOUNDER_PASSWORD=founder123
FUSEHEALTH_SEO_PASSWORD=
FUSEHEALTH_ADS_PASSWORD=

# ----------------------------------------------------------------------------
# Google APIs — GSC + GA4            [READY]  OAuth refresh token valid
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN
# Google Search Console property — use sc-domain: for domain properties
GSC_SITE_URL=sc-domain:your-site.com
# GA4 numeric property ID only
GA4_PROPERTY_ID=YOUR_GA4_PROPERTY_ID

# Google API key — PageSpeed Insights, etc.   [PRESENT]
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# Google Ads — apply for Standard Access before use   [EMPTY]
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ----------------------------------------------------------------------------
# OpenAI — AI summaries              [READY]  key valid
# ----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY

# ----------------------------------------------------------------------------
# DataForSEO — SERP + Keywords + Backlinks + OnPage   [READY auth]
# NOTE: auth PASSES but the account BALANCE WAS NEGATIVE at the last audit.
#       Top up at https://dataforseo.com or these connectors return no data.
# ----------------------------------------------------------------------------
DATAFORSEO_LOGIN=your@email.com
DATAFORSEO_PASSWORD=YOUR_DATAFORSEO_PASSWORD
# Target domain for rank tracking — no https://, no trailing slash
DATAFORSEO_TARGET_DOMAIN=your-site.com

# ----------------------------------------------------------------------------
# Meta Marketing API                 [EMPTY]
# Use a System User token (never expires), not a personal token
# ----------------------------------------------------------------------------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=          # format: act_XXXXXXXXXX

# ----------------------------------------------------------------------------
# LinkedIn Ads API                   [EMPTY]
# ----------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_ACCOUNT_ID=         # numeric account ID

# ----------------------------------------------------------------------------
# Webflow                            [EMPTY]
# ----------------------------------------------------------------------------
WEBFLOW_API_KEY=
WEBFLOW_SITE_ID=
WEBFLOW_COLLECTION_IDS=      # comma-separated collection IDs

# ----------------------------------------------------------------------------
# WordPress                          [EMPTY]
# ----------------------------------------------------------------------------
WP_SITE_URL=https://your-wp-site.com
WP_USERNAME=
WP_APP_PASSWORD=             # Settings -> Application Passwords

# ----------------------------------------------------------------------------
# Framer (sitemap only — no data API)   [EMPTY]
# ----------------------------------------------------------------------------
FRAMER_SITEMAP_URL=https://your-framer-site.com/sitemap.xml

# ----------------------------------------------------------------------------
# Sentry — error monitoring                [EMPTY]
# Leave SENTRY_DSN blank to disable entirely: nothing is initialised and the
# sentry-sdk package is never imported. Test runs never report, even with a DSN set.
# ----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# 0.0 = no performance tracing (errors only). Raise toward 1.0 to sample traces.
SENTRY_TRACES_SAMPLE_RATE=0.0

# ----------------------------------------------------------------------------
# Email / outbound links
# ----------------------------------------------------------------------------
# With EMAIL_HOST_USER blank, Django falls back to the console backend so dev never
# crashes on a missing SMTP server — the invite email prints to the runserver log.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=
# Base URL for links in invitation emails. LEAVE BLANK in normal setups: the link is
# built from the origin the request arrived on, so a dev box mails
# http://localhost:8000/... and the deployed site mails https://<your-domain>/...
# with no config. Set it only if the SPA is served from a different origin than the API.
FRONTEND_URL=
